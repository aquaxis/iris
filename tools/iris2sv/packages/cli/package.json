{
  "name": "@iris2sv/cli",
  "version": "0.1.0",
  "description": "IRIS to SystemVerilog CLI tool",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris2sv": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": ["dist"],
  "dependencies": {
    "@iris2sv/core": "workspace:*",
    "@iris2sv/analyzer": "workspace:*",
    "@iris2sv/transform": "workspace:*",
    "@iris2sv/sv-backend": "workspace:*",
    "commander": "^11.1.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
