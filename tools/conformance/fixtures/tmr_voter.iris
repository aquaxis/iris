/// 三重冗長多数決（TMR voter）
///
/// 3つの入力`a`／`b`／`c`のビットごとの多数決を`y`へ出す（`y = a&b | b&c | a&c`）。
/// どれか1つがビット反転しても多数決で正しい値が残る（単一故障の吸収）。
/// 3入力のどこかが食い違うと`mismatch`を1にする（故障の検出・通知に使う）。
/// 三重化した論理の出力合流、SEU（ソフトエラー）耐性、機能安全などに使う。組み合わせのみ。
///
/// 多数決はビットごとのAND/OR、不一致は3対の差（XOR）のORリダクション。
///
/// ジェネリックパラメータ:
/// - Width: ビット幅（既定8、1以上）
///
/// ポート:
/// - a／b／c:   三重化した入力
/// - y:         ビットごとの多数決結果
/// - mismatch:  3入力のどこかが食い違うと1（1ビット）
mod TmrVoter[Width: uint = 8]
where
    Width >= 1,
(
    in  a: bit[Width],
    in  b: bit[Width],
    in  c: bit[Width],
    out y: bit[Width],
    out mismatch: bit,
) {
    comb {
        y = (a & b) | (b & c) | (a & c);
        mismatch = ((a ^ b) | (b ^ c) | (a ^ c)).or_reduce();
    }
}
