/// リングカウンタ（ワンホット巡回カウンタ、N状態）
///
/// Widthビットのレジスタに1つだけ立てたビットを、`en`のたびに1つ隣へ巡回させる。
/// 0…01 → 0…10 → … → 10…0 → 0…01 と、Width状態をワンホットのまま巡る。
/// `Right`が0なら左（上位方向）へ、1なら右（下位方向）へ回す。
/// 位相／ステート生成、ワンホットFSMの歩進、マルチプレクサの選択信号などに使う。
/// ジョンソンカウンタ（`JohnsonCounter`、2N状態のツイストリング）と対になる。
///
/// 左回転は`{ r[Width-2:0], r[Width-1] }`（下位Width-1ビットを上へ、最上位を最下位へ）。
/// ワンホットは全0が吸収状態（回しても全0のまま）なので、リセット値は`1`（最下位ビット）とする。
///
/// ジェネリックパラメータ:
/// - Width: ビット幅＝状態数（既定8、2以上）
/// - Right: 回転の向き（0=左、1=右、既定0）
///
/// ポート:
/// - en: 1で1状態進める（0なら保持）
/// - q:  現在のワンホット状態
///
/// リセットは非同期assert・同期deassert、能動High（0…01から始まる）。
mod RingCounter[
    Width: uint = 8,
    Right: uint = 0,
]
where
    Width >= 2,
(
    in  clk: clock,
    in  rst: reset,
    in  en:  bit,
    out q: bit[Width],
) {
    var r: bit[Width] = 1;

    sync(clk.posedge, rst.async) {
        if rst {
            r = 1;
        } else if en {
            if Right == 0 {
                r = { r[Width - 2 : 0], r[Width - 1] };   // 左回転（上位方向）
            } else {
                r = { r[0], r[Width - 1 : 1] };           // 右回転（下位方向）
            }
        }
    }

    comb {
        q = r;
    }
}
