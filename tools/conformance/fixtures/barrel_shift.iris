/// バレルシフタ（可変量の論理／算術シフト）
///
/// `din`を`amt`ビットだけシフトする組み合わせ回路。`Rotator`が巡回（あふれを反対側へ回す）
/// なのに対し、こちらはシフト（空いた側を0または符号で埋める）。乗算・スケーリング、
/// ビット抽出、可変長デコードなどに使う。
///
/// `Right`が0なら左シフト（`din << amt`、下位に0）、1なら右シフト。右シフトは`Arith`が0なら
/// 論理（上位に0）、1なら算術（最上位ビットを複製＝符号を保つ）。左シフトに算術・論理の区別はない。
/// `amt`が0のときはそのまま`din`を返す。
///
/// IRISの`>>`は`.signed()`でも論理シフト（上位に0）なので、算術右シフトは手で組む：
/// 論理右シフトに、符号ビットが1のときだけ上位`amt`ビットのマスクをORする。
/// 全ビット1は`din | ~din`で作り（Width幅）、`>> amt`で下位(Width-amt)ビットの1にし、
/// `~`で反転して上位`amt`ビットの1にする。combは更新した信号を読み直せないので、
/// 論理シフトとマスクは1つの式に書く（`dout = dout | ...`とは書かない）。
///
/// ジェネリックパラメータ:
/// - Width:   データ幅（既定8、2以上）
/// - Right:   向き（0=左、1=右、既定0）
/// - Arith:   右シフトの種類（0=論理、1=算術。右シフトのみ有効、既定0）
/// - ShWidth: シフト量の幅（導出＝$clog2(Width)）
///
/// ポート:
/// - din:  入力データ
/// - amt:  シフト量（0..Width-1）
/// - dout: シフト後のデータ
mod BarrelShift[
    Width: uint = 8,
    Right: uint = 0,
    Arith: uint = 0,
    ShWidth: uint = $clog2(Width),
]
where
    Width >= 2,
(
    in  din:  bit[Width],
    in  amt:  bit[ShWidth],
    out dout: bit[Width],
) {
    comb {
        if Right == 1 {
            if Arith == 1 {
                // 算術右シフト：符号ビットが1なら上位amtビットを1で埋める
                if din[Width - 1] == 1 {
                    dout = (din >> amt) | ~((din | ~din) >> amt);
                } else {
                    dout = din >> amt;
                }
            } else {
                // 論理右シフト：上位に0を詰める
                dout = din >> amt;
            }
        } else {
            // 左シフト：下位に0を詰める
            dout = din << amt;
        }
    }
}
