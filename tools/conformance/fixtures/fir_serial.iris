/// 直列（時分割）FIRフィルタ
///
/// 1つの乗算器を時分割で使い、1入力サンプルにつきTapsサイクルかけて
/// y[n] = Σ_{k=0}^{Taps-1} coeff[k] * x[n-k] を求める。
/// 係数は書き込みポート（coeff_we／coeff_addr／coeff_data）で読み込む。
/// サンプルは`in_valid`＋`in_data`で1つずつ入れ、結果は`out_valid`＋`out_data`で出す。
///
/// combでは畳み込み（積算）を書けないが、直列にして時間へ展開すればsyncの逐次
/// 加算で書ける（段L3の方針どおり）。乗算はオペランド幅に切り詰められるので、
/// 係数とサンプルはAccWidth幅のmemに零拡張して持ち、積が切り詰められないようにする。
///
/// ジェネリックパラメータ:
/// - Width:      サンプルのビット幅（既定8、1以上）
/// - Taps:       タップ数（既定4、2以上）
/// - CoeffWidth: 係数のビット幅（既定8、1以上）
/// - AccWidth:   累算・積・出力の幅（導出＝Width+CoeffWidth+$clog2(Taps)。積の和があふれない）
/// - IdxWidth:   遅延線・係数の添字幅（導出＝$clog2(Taps)）
/// - CntWidth:   タップ計数の幅（導出＝$clog2(Taps)+1。0..Tapsを数える）
///
/// ポート:
/// - coeff_we／coeff_addr／coeff_data: 係数の書き込み（addrはタップ番号k）
/// - in_valid／in_data: 新しいサンプル（busyでないとき受け付ける）
/// - out_valid:  出力が有効な1サイクルだけ1
/// - out_data:   フィルタ出力 y[n]
/// - busy:       計算中は1
///
/// 数は符号なし（unsigned）で扱う。符号付きFIRはint型が要る（今後の課題）。
/// リセットは非同期assert・同期deassert、能動High。累算器・添字は0で始まる。
mod FirSerial[
    Width: uint = 8,
    Taps: uint = 4,
    CoeffWidth: uint = 8,
    AccWidth: uint = Width + CoeffWidth + $clog2(Taps),
    IdxWidth: uint = $clog2(Taps),
    CntWidth: uint = $clog2(Taps) + 1,
]
where
    Width >= 1,
    Taps >= 2,
    CoeffWidth >= 1,
(
    in  clk: clock,
    in  rst: reset,
    in  coeff_we: bit,
    in  coeff_addr: bit[IdxWidth],
    in  coeff_data: bit[CoeffWidth],
    in  in_valid: bit,
    in  in_data: bit[Width],
    out out_valid: bit,
    out out_data: bit[AccWidth],
    out busy: bit,
) {
    mem coeffs: bit[AccWidth][Taps];
    mem samples: bit[AccWidth][Taps];

    var st: bit = 0;
    var head: bit[IdxWidth] = 0;
    var rd_idx: bit[IdxWidth] = 0;
    var tap: bit[CntWidth] = 0;
    var acc: bit[AccWidth] = 0;
    var out_r: bit[AccWidth] = 0;
    var out_valid_r: bit = 0;

    sync(clk.posedge, rst.async) {
        out_valid_r = 0;

        // 係数の読み込みはFSMと独立。零拡張してAccWidth幅で持つ。
        if coeff_we {
            coeffs[coeff_addr] = coeff_data;
        }

        if st == 0 {
            if in_valid {
                // 最新サンプルをheadの位置へ書き、読み出しをheadから始める。
                samples[head] = in_data;
                rd_idx = head;
                if head == Taps - 1 {
                    head = 0;
                } else {
                    head = head + 1;
                }
                acc = 0;
                tap = 0;
                st = 1;
            }
        } else {
            if tap == Taps {
                // Tapsサイクル分を足し終えた次のサイクルで確定値を出す。
                out_r = acc;
                out_valid_r = 1;
                st = 0;
            } else {
                acc = acc + coeffs[tap] * samples[rd_idx];
                if rd_idx == 0 {
                    rd_idx = Taps - 1;
                } else {
                    rd_idx = rd_idx - 1;
                }
                tap = tap + 1;
            }
        }
    }

    comb {
        out_valid = out_valid_r;
        out_data = out_r;
        busy = st != 0;
    }
}
