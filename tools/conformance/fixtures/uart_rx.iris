/// UART受信器
///
/// アイドル高の`rx`線から、スタートビット・データ8ビット（LSB先頭）・ストップビットを
/// 受け取り、`data`に1バイトを出して`valid`を1サイクル立てる。1ビットは`ClksPerBit`。
/// スタートビットの立下りを検出し、各ビットの中央で標本化する。
///
/// ジェネリックパラメータ:
/// - ClksPerBit: 1ビットのクロック数（既定4、2以上）
/// - CntWidth:   ビット時間カウンタ幅（導出）
/// - HalfBit:    ビット中央までのクロック数（`ClksPerBit / 2`、導出）
///
/// リセットは非同期assert・同期deassert、能動High。
mod UartRx[
    ClksPerBit: uint = 4,
    CntWidth: uint = $clog2(ClksPerBit),
    HalfBit: uint = ClksPerBit / 2,
]
where
    ClksPerBit >= 2,
(
    in  clk: clock,
    in  rst: reset,
    in  rx: bit,
    out data: bit[8],
    out valid: bit,
) {
    var st: bit[2] = 0;
    var clk_cnt: bit[CntWidth] = 0;
    var bit_idx: bit[3] = 0;
    var shift: bit[8] = 0;
    var data_r: bit[8] = 0;
    var valid_r: bit = 0;

    sync(clk.posedge, rst.async) {
        valid_r = 0;
        if st == 2'd0 {
            if ~rx {
                clk_cnt = 0;
                st = 2'd1;
            }
        } else {
            if st == 2'd1 {
                if clk_cnt == HalfBit - 1 {
                    clk_cnt = 0;
                    bit_idx = 0;
                    st = 2'd2;
                } else {
                    clk_cnt = clk_cnt + 1;
                }
            } else {
                if st == 2'd2 {
                    if clk_cnt == ClksPerBit - 1 {
                        clk_cnt = 0;
                        shift = { rx, shift[7:1] };
                        if bit_idx == 3'd7 {
                            st = 2'd3;
                        } else {
                            bit_idx = bit_idx + 1;
                        }
                    } else {
                        clk_cnt = clk_cnt + 1;
                    }
                } else {
                    if clk_cnt == ClksPerBit - 1 {
                        clk_cnt = 0;
                        data_r = shift;
                        valid_r = 1;
                        st = 2'd0;
                    } else {
                        clk_cnt = clk_cnt + 1;
                    }
                }
            }
        }
    }

    comb {
        data = data_r;
        valid = valid_r;
    }
}
