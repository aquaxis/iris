/// ストリームスロットル（アウトスタンディング数の制限）
///
/// ready/validのストリームをそのまま通すが、発行済みで未完了の（in-flightな）
/// トランザクション数を`MaxOutstanding`までに制限する。上限に達している間は
/// 前方を止める（`out_valid=0`・`in_ready=0`）。発行1つにつき完了1つを`done`で返し、
/// アウトスタンディング数を戻す。読み出しの追い越し数やバス上の未応答数を縛る用途に使う。
///
/// 発行（issue）は`out_valid & out_ready`が立ったサイクル（1語が下流に渡ったとき）、
/// 完了（done）は`done`が1のサイクル。発行と完了が同一サイクルなら相殺（増減なし）。
/// `done`は発行済みトランザクションに対してのみ与える前提（0での`done`は下限を割る）。
///
/// ジェネリックパラメータ:
/// - Width:          データのビット幅（既定8、1以上）
/// - CntWidth:       アウトスタンディングカウンタのビット幅（既定4、MaxOutstandingが収まること）
/// - MaxOutstanding: 同時に許す未完了数（既定4）
///
/// ポート:
/// - in_valid／in_data／in_ready:   入力側ハンドシェイク
/// - out_valid／out_data／out_ready: 出力側ハンドシェイク
/// - done:        1で未完了を1つ戻す（発行済みトランザクションの完了通知）
/// - outstanding: 現在の未完了数
///
/// リセットは非同期assert・同期deassert、能動High。未完了0で始まる。
mod StreamThrottle[
    Width: uint = 8,
    CntWidth: uint = 4,
    MaxOutstanding: uint = 4,
]
where
    Width >= 1,
(
    in  clk: clock,
    in  rst: reset,
    in  in_valid: bit,
    in  in_data: bit[Width],
    out in_ready: bit,
    out out_valid: bit,
    out out_data: bit[Width],
    in  out_ready: bit,
    in  done: bit,
    out outstanding: bit[CntWidth],
) {
    var cnt: bit[CntWidth] = 0;

    // `&`と比較の混在（iris2svが片方を1ビットに切り詰める既知の癖）を避け、
    // 発行の可否はif文の入れ子で判定する。
    //   issue = in_valid & (cnt < MaxOutstanding) & out_ready
    //   done  = done
    // issueとdoneが同時なら相殺（net 0）。
    sync(clk.posedge, rst.async) {
        if rst {
            cnt = 0;
        } else {
            if in_valid {
                if out_ready {
                    if cnt < MaxOutstanding {
                        if ~done { cnt = cnt + 1; }   // 発行のみ（+1）／発行かつ完了は相殺
                    } else {
                        if done { cnt = cnt - 1; }     // 満杯で発行不可、完了のみ（-1）
                    }
                } else {
                    if done { cnt = cnt - 1; }         // 下流not ready、完了のみ
                }
            } else {
                if done { cnt = cnt - 1; }             // 入力なし、完了のみ
            }
        }
    }

    comb {
        // can_issue = cnt < MaxOutstanding。満杯なら前方を止める。
        if cnt < MaxOutstanding {
            out_valid = in_valid;
            in_ready = out_ready;
        } else {
            out_valid = 0;
            in_ready = 0;
        }
        out_data = in_data;
        outstanding = cnt;
    }
}
