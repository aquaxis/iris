/// ワンホットマルチプレクサ（Mux1H、N入力1出力）
///
/// ワンホットの選択線`sel`（Nビット、1つだけ1）で、N個の入力語から1つを選んで出す。
/// デコード済みの制御線でデータ経路を選ぶ用途に使う（`VecMux`が2進の`sel`で選ぶのに対し、
/// こちらはワンホットの`sel`で選ぶ。命令デコードやALU結果選択などワンホット制御が自然な場面向き）。
///
/// IRISは配列ポートを持たないので、N個の入力は連結パックドベクタ`bit[Width*N]`で受け、
/// 要素iは`data[i*Width +: Width]`で取り出す（`VecMux`/`VecDemux`と同じ）。
/// combは総和/論理和の畳み込みはできないが、これは選択なので書ける：`out = 0`を既定に、
/// `sel[i]`が1の要素で上書きする。ワンホットならちょうど1回だけ上書きされる
/// （`sel`が0なら0、複数ビット立つ不正入力なら最大添字が勝つ＝last-wins）。組み合わせのみ。
///
/// ジェネリックパラメータ:
/// - Width: 1語のビット幅（既定8、1以上）
/// - N:     入力語数＝選択線の幅（既定4、2以上）
/// - Total: パックドベクタの総幅（導出＝Width*N）
///
/// ポート:
/// - sel:     ワンホット選択線（Nビット）
/// - data:    連結した入力語（要素iは`data[i*Width +: Width]`）
/// - out_val: 選ばれた語（selが0なら0）
mod Mux1H[
    Width: uint = 8,
    N: uint = 4,
    Total: uint = Width * N,
]
where
    Width >= 1,
    N >= 2,
(
    in  sel:     bit[N],
    in  data:    bit[Total],
    out out_val: bit[Width],
) {
    comb {
        out_val = 0;
        for i in 0..N {
            if sel[i] {
                out_val = data[i * Width +: Width];
            }
        }
    }
}
