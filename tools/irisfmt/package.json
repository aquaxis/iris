{
  "name": "@aquaxis/irisfmt",
  "version": "0.1.0",
  "private": true,
  "description": "IRIS language formatter toolchain",
  "author": "Hidemi Ishihara",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src/**/*.ts",
    "lint:fix": "eslint packages/*/src/**/*.ts --fix",
    "format": "prettier --write packages/*/src/**/*.ts",
    "format:check": "prettier --check packages/*/src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "homepage": "https://github.com/aquaxis/iris/iris2sv#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aquaxis/iris.git"
  },
  "bugs": {
    "url": "https://github.com/aquaxis/iris/issues"
  },
  "packageManager": "pnpm@9.0.0"
}