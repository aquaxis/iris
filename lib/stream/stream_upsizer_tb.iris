/// StreamUpsizerのテストベンチ
///
/// N=4／Width=8で、狭い語 AA→BB→CC→DD を集めて広い語0xDDCCBBAAにまとめること、
/// そろうまではout_validが下がっていることを確かめる。out_readyは常に1。
test StreamUpsizerTB {
    let clk: clock(period: 10ns);
    let rst: reset;
    var in_valid: bit = 0;
    var in_data: bit[8] = 0;
    var out_ready: bit = 1;
    var step: bit[8] = 0;

    inst dut = StreamUpsizer {
        clk: clk, rst: rst, in_valid: in_valid, in_data: in_data, out_ready: out_ready
    };

    sync(clk.posedge, rst.async) {
        if rst { step = 0; } else {
            step = step + 1;
            if step == 8'd1 { in_valid = 1; in_data = 8'hAA; }
            if step == 8'd2 { in_data = 8'hBB; }
            if step == 8'd3 { in_data = 8'hCC; }
            if step == 8'd4 { in_data = 8'hDD; }
            if step == 8'd5 { in_valid = 0; }
        }
    }

    sync(clk.posedge, rst.async) {
        if !rst {
            if step == 8'd5 { assert dut.out_valid == 0, "not full yet"; }
            if step == 8'd6 { assert dut.out_valid == 1, "full"; assert dut.out_data == 32'hDDCCBBAA, "assembled word"; }
            if step == 8'd7 { assert dut.out_valid == 0, "taken"; assert dut.in_ready == 1, "ready again"; }
        }
    }

    seq {
        await clk.cycles(9);
        $display("StreamUpsizerTB: all checks passed");
        $finish;
    }
}
