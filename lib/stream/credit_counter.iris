/// クレジットカウンタ（クレジットベースのフロー制御）
///
/// 使えるクレジット数を数える。`give`で1つ返し（増やし）、`take`で1つ使う（減らす）。
/// クレジットが残っていれば`available`が1。送信側が`available`を見て送出し、受信側が
/// バッファを空けたら`give`でクレジットを返す、というフロー制御に使う。
///
/// リセットで`MaxCredit`から始める。`give`と`take`が同時のときは増減しない（相殺）。
/// `take`は`available`が1のときだけ行うのが前提（0での`take`は下限を割る）。
///
/// ジェネリックパラメータ:
/// - Width:     カウンタのビット幅（既定8、1以上、MaxCreditが収まること）
/// - MaxCredit: 初期（最大）クレジット数（既定8）
///
/// ポート:
/// - give:      1でクレジットを1つ返す（増やす）
/// - take:      1でクレジットを1つ使う（減らす）
/// - available: クレジットが残っていれば1（count != 0）
/// - count:     現在のクレジット数
///
/// リセットは非同期assert・同期deassert、能動High。
mod CreditCounter[
    Width: uint = 8,
    MaxCredit: uint = 8,
]
where
    Width >= 1,
(
    in  clk: clock,
    in  rst: reset,
    in  give: bit,
    in  take: bit,
    out available: bit,
    out count: bit[Width],
) {
    var cnt: bit[Width] = MaxCredit;

    sync(clk.posedge, rst.async) {
        if rst {
            cnt = MaxCredit;
        } else {
            if give == 1 {
                if take == 0 { cnt = cnt + 1; }
            } else {
                if take == 1 { cnt = cnt - 1; }
            }
        }
    }

    comb {
        available = cnt != 0;
        count = cnt;
    }
}
