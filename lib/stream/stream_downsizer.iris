/// ストリームダウンサイザ（幅変換、広い語→狭い語、ready/valid）
///
/// 幅`Width*N`の入力語1つを、幅`Width`の狭い語N個に分けて出す（LSB側の要素から順に）。
/// バス幅の縮小、広いFIFO出力を細いIFへ渡すなどに使う。ready/validでバックプレッシャに従う。
///
/// 入力語を受けたら保持レジスタに取り込み、`out_ready`のたびに1要素ずつ出す（要素iは
/// `hold[i*Width +: Width]`）。取り込み中は`in_ready`を下げ、最後の要素が取られたら次の語を受ける。
/// 添字は積`cnt*Width`が桁あふれしないよう`IdxWidth`へ拡張してから掛ける。
///
/// ジェネリックパラメータ:
/// - Width:    出力（狭い語）のビット幅（既定8、1以上）
/// - N:        分割数（既定4、2以上）
/// - Total:    入力（広い語）のビット幅（導出＝Width*N）
/// - CntWidth: 要素カウンタの幅（導出＝$clog2(N)）
/// - IdxWidth: ビット位置計算の幅（導出＝$clog2(Width*N)+1）
///
/// ポート:
/// - in_valid／in_data／in_ready: 入力側ハンドシェイク（広い語）
/// - out_valid／out_data／out_ready: 出力側ハンドシェイク（狭い語、N個）
///
/// リセットは非同期assert・同期deassert、能動High。
mod StreamDownsizer[
    Width: uint = 8,
    N: uint = 4,
    Total: uint = Width * N,
    CntWidth: uint = $clog2(N),
    IdxWidth: uint = $clog2(Width * N) + 1,
]
where
    Width >= 1,
    N >= 2,
(
    in  clk: clock,
    in  rst: reset,
    in  in_valid: bit,
    in  in_data: bit[Total],
    out in_ready: bit,
    out out_valid: bit,
    out out_data: bit[Width],
    in  out_ready: bit,
) {
    var hold: bit[Total] = 0;
    var cnt: bit[CntWidth] = 0;
    var busy: bit = 0;

    sync(clk.posedge, rst.async) {
        if rst {
            busy = 0;
            cnt = 0;
        } else if busy == 0 {
            if in_valid == 1 {
                hold = in_data;
                cnt = 0;
                busy = 1;
            }
        } else {
            if out_ready == 1 {
                if cnt == N - 1 {
                    busy = 0;
                } else {
                    cnt = cnt + 1;
                }
            }
        }
    }

    comb {
        in_ready = busy == 0;
        out_valid = busy;
        out_data = hold[cnt.resize(IdxWidth) * Width +: Width];
    }
}
