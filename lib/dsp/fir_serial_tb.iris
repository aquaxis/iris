/// FirSerialのテストベンチ
///
/// 係数[1,2,3,4]（coeff[0]が最新サンプルに掛かる）を読み込み、
/// サンプル10,20,30,40,50を1つずつ入れて、畳み込みの出力を確かめる。
/// 遅延線は0で始まるので、出力は 10,40,100,200,300 になる。
///   y1 = 1*10                       = 10
///   y2 = 1*20+2*10                  = 40
///   y3 = 1*30+2*20+3*10             = 100
///   y4 = 1*40+2*30+3*20+4*10        = 200
///   y5 = 1*50+2*40+3*30+4*20        = 300
test FirSerialTB {
    let clk: clock(period: 10ns);
    let rst: reset;

    var step: bit[16] = 0;
    var in_valid: bit = 0;
    var in_data: bit[8] = 0;
    var coeff_we: bit = 0;
    var coeff_addr: bit[2] = 0;
    var coeff_data: bit[8] = 0;

    var out_cnt: bit[8] = 0;
    var y1: bit[18] = 0;
    var y2: bit[18] = 0;
    var y3: bit[18] = 0;
    var y4: bit[18] = 0;
    var y5: bit[18] = 0;

    inst dut = FirSerial {
        clk: clk, rst: rst,
        coeff_we: coeff_we, coeff_addr: coeff_addr, coeff_data: coeff_data,
        in_valid: in_valid, in_data: in_data,
    };

    sync(clk.posedge, rst.async) {
        if rst {
            step = 0;
            in_valid = 0;
            coeff_we = 0;
            out_cnt = 0;
        } else {
            step = step + 1;
            in_valid = 0;
            coeff_we = 0;

            // 係数を読み込む（k=0..3 に 1,2,3,4）
            if step == 1 { coeff_we = 1; coeff_addr = 0; coeff_data = 1; }
            if step == 2 { coeff_we = 1; coeff_addr = 1; coeff_data = 2; }
            if step == 3 { coeff_we = 1; coeff_addr = 2; coeff_data = 3; }
            if step == 4 { coeff_we = 1; coeff_addr = 3; coeff_data = 4; }

            // サンプルを十分な間隔で入れる（1サンプル＝約Taps+2サイクル）
            if step == 10 { in_valid = 1; in_data = 10; }
            if step == 20 { in_valid = 1; in_data = 20; }
            if step == 30 { in_valid = 1; in_data = 30; }
            if step == 40 { in_valid = 1; in_data = 40; }
            if step == 50 { in_valid = 1; in_data = 50; }

            // 出力を順に捕まえる（out_cntは代入前の値＝これまでの個数）
            if dut.out_valid {
                if out_cnt == 0 { y1 = dut.out_data; }
                if out_cnt == 1 { y2 = dut.out_data; }
                if out_cnt == 2 { y3 = dut.out_data; }
                if out_cnt == 3 { y4 = dut.out_data; }
                if out_cnt == 4 { y5 = dut.out_data; }
                out_cnt = out_cnt + 1;
            }
        }
    }

    seq {
        await clk.cycles(70);
        assert out_cnt == 8'd5, "five outputs were produced";
        assert y1 == 18'd10,  "y1 = 1*10";
        assert y2 == 18'd40,  "y2 = 1*20+2*10";
        assert y3 == 18'd100, "y3 = 1*30+2*20+3*10";
        assert y4 == 18'd200, "y4 = 1*40+2*30+3*20+4*10";
        assert y5 == 18'd300, "y5 = 1*50+2*40+3*30+4*20";
        $display("FirSerialTB: all checks passed");
        $finish;
    }
}
