/// 簡易デュアルポートRAM（書き込み1ポート・読み出し1ポート、登録読み出し）
///
/// 書き込みポート（`we`／`waddr`／`din`）と読み出しポート（`raddr`／`dout`）を
/// 別々に持つ同期RAMである。同じクロックで、書きながら別アドレスを読める。
/// FIFOや行バッファの土台に使う。読み出しは1サイクル遅れる（同期読み出し）。
/// 書き込みアドレスと読み出しアドレスが同じサイクルで一致すると、`dout`には
/// 書き込み前の古い値が出る（read-before-write）。
///
/// ジェネリックパラメータ:
/// - Width:     語のビット幅（既定8、1以上）
/// - Depth:     語数（既定256、2以上）
/// - AddrWidth: アドレス幅（導出＝$clog2(Depth)）
///
/// ポート:
/// - we:    1で書き込み
/// - waddr: 書き込みアドレス
/// - din:   書き込みデータ
/// - raddr: 読み出しアドレス
/// - dout:  読み出しデータ（1サイクル遅れ）
///
/// RAMの中身はリセットしない（メモリはリセット対象にしない）。
/// リセットは出力レジスタ`dout`だけを0に戻す（非同期assert・同期deassert、能動High）。
mod RamDp[
    Width: uint = 8,
    Depth: uint = 256,
    AddrWidth: uint = $clog2(Depth),
]
where
    Width >= 1,
    Depth >= 2,
(
    in  clk: clock,
    in  rst: reset,
    in  we: bit,
    in  waddr: bit[AddrWidth],
    in  din: bit[Width],
    in  raddr: bit[AddrWidth],
    out dout: bit[Width],
) {
    mem storage: bit[Width][Depth];
    var dout_r: bit[Width] = 0;

    sync(clk.posedge, rst.async) {
        if rst {
            dout_r = 0;
        } else {
            if we {
                storage[waddr] = din;
            }
            dout_r = storage[raddr];
        }
    }

    comb {
        dout = dout_r;
    }
}
