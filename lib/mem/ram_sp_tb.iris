/// RamSpのテストベンチ
///
/// Depth=4で、アドレス0,1,2,3に 10,20,30,40 を書き、読み戻して確かめる。
/// 読み出しは1サイクル遅れる（同期読み出し）ので、addrを出してから次のサイクルの
/// doutを見る。同一アドレスへの同時読み書きでは書き込み前の古い値が出ることも確かめる。
test RamSpTB {
    let clk: clock(period: 10ns);
    let rst: reset;

    var step: bit[16] = 0;
    var we: bit = 0;
    var addr: bit[2] = 0;
    var din: bit[8] = 0;

    var r0: bit[8] = 0;
    var r1: bit[8] = 0;
    var r2: bit[8] = 0;
    var r3: bit[8] = 0;
    var rold: bit[8] = 0;

    inst dut = RamSp[Width: 8, Depth: 4] {
        clk: clk, rst: rst, we: we, addr: addr, din: din,
    };

    sync(clk.posedge, rst.async) {
        if rst {
            step = 0;
            we = 0;
        } else {
            step = step + 1;
            we = 0;

            // 書き込み：addr0..3 に 10,20,30,40
            if step == 1 { we = 1; addr = 0; din = 10; }
            if step == 2 { we = 1; addr = 1; din = 20; }
            if step == 3 { we = 1; addr = 2; din = 30; }
            if step == 4 { we = 1; addr = 3; din = 40; }

            // 読み出し：addrを出してから2サイクル後にdoutへ出る
            // （TBのaddrレジスタで1、RAMの同期読み出しで1）。
            if step == 6 { addr = 0; }
            if step == 7 { addr = 1; }
            if step == 8 { addr = 2; r0 = dut.dout; }
            if step == 9 { addr = 3; r1 = dut.dout; }
            if step == 10 { r2 = dut.dout; }
            if step == 11 { r3 = dut.dout; }

            // read-before-write：addr0へ書きながら、同じサイクルの読み出しは古い値を返す
            if step == 13 { we = 1; addr = 0; din = 99; }
            if step == 15 { rold = dut.dout; }
        }
    }

    seq {
        await clk.cycles(20);
        assert r0 == 8'd10, "addr0 holds 10";
        assert r1 == 8'd20, "addr1 holds 20";
        assert r2 == 8'd30, "addr2 holds 30";
        assert r3 == 8'd40, "addr3 holds 40";
        assert rold == 8'd10, "read-before-write returns the old value 10";
        $display("RamSpTB: all checks passed");
        $finish;
    }
}
