/// 符号反転（2の補数の否定）
///
/// 符号付き`a`（2の補数）の符号を反転した`y = -a`を出す（`~a + 1`）。
/// 減算器の被減数生成、符号付きDSPの係数反転、極性切替などに使う。組み合わせのみ。
///
/// 最小負値（0x80..）だけは同じ幅で正に表せず、否定してもそのまま0x80..へ戻る（ラップ）。
/// この1点だけ`ovf`を1にして呼び出し側に知らせる（飽和させたい場合は`SatSub`で`0 - a`を作る）。
/// `ovf`は`a == 0x80..`、すなわち最上位ビットだけ1で下位が全0のときに立つ。
///
/// ジェネリックパラメータ:
/// - Width: ビット幅（既定8、2以上）
///
/// ポート:
/// - a:   入力（符号付き2の補数）
/// - y:   符号反転結果（-a）
/// - ovf: 否定が幅内で表せないとき1（a が最小負値のとき、1ビット）
mod Negate[Width: uint = 8]
where
    Width >= 2,
(
    in  a: bit[Width],
    out y: bit[Width],
    out ovf: bit,
) {
    comb {
        // 否定は `0 - a`。`~a + 1` と等価だが、こちらはNOTを32ビット文脈に置かず、
        // verilatorが`-Wall`でも幅警告を出さない（`SignMag`と同じ手筋）。
        y = 0 - a;
        // 最小負値の判定：最上位ビットが1で、下位ビットが全0（-a が同じ値に戻る唯一の点）。
        // `a & (~a + 1)`（最下位の1）が最上位ビットに一致することでも書けるが、
        // 素直に「上位1・下位0」を分けて調べる。
        if a[Width - 1] == 1 {
            if a[Width - 2 : 0] == 0 {
                ovf = 1;
            } else {
                ovf = 0;
            }
        } else {
            ovf = 0;
        }
    }
}
