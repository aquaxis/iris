/// 末尾ゼロ数（Count Trailing Zeros）
///
/// 入力`d`の最下位側から数えて、最初の1に達するまでの0の個数を出す（＝最下位の1の添字）。
/// どのビットも立っていなければ`Width`を返す。`Lzc`（先頭ゼロ数）の対で、
/// 最下位の1の位置を求める（優先エンコーダ、アライメント、2の冪の判定などに使う）。
///
/// 実装は組み合わせ。combは選択（最後の代入が勝つ）なので、最下位の1を最後に処理すれば
/// それが残る。IRISの`for`は低→高に回るため、添字を`Width-1-i`として**高→低**に走らせ、
/// 1のたびに`count = Width-1-i`を代入する。最後に勝つのは最下位の1で、それが末尾ゼロ数になる。
/// 1が無ければ既定の`Width`が残る。
///
/// ジェネリックパラメータ:
/// - Width:      入力ビット幅（既定8、1以上）
/// - CountWidth: 出力幅（既定`$clog2(Width)+1`。0からWidthまで表せる）
///
/// ポート:
/// - d:     入力
/// - count: 末尾ゼロ数（最下位の1の添字。全0ならWidth）
mod Ctz[
    Width: uint = 8,
    CountWidth: uint = $clog2(Width) + 1,
]
where
    Width >= 1,
(
    in  d: bit[Width],
    out count: bit[CountWidth],
) {
    comb {
        count = Width;
        for i in 0..Width {
            // 添字を高→低に走らせ、最下位の1が最後に勝つようにする
            if d[Width - 1 - i] {
                count = Width - 1 - i;
            }
        }
    }
}
