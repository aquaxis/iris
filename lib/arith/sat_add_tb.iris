/// SatAddのテストベンチ
///
/// 符号なし・符号付きの両方で、通常の加算と、上限/下限への飽和を確かめる。
/// 組み合わせなので入力を変えて次のサイクルで読む。
test SatAddTB {
    let clk: clock(period: 10ns);
    var a: bit[8] = 0;
    var b: bit[8] = 0;
    var step: bit[8] = 0;

    inst u = SatAdd { a: a, b: b };            // 符号なし
    inst s = SatAdd[Signed: 1] { a: a, b: b }; // 符号付き

    sync(clk.posedge) {
        step = step + 1;
        if step == 8'd1 { a = 8'd10;  b = 8'd20;  }   // u:30      s:30
        if step == 8'd2 { a = 8'd200; b = 8'd100; }   // u:sat255  s:(-56)+100=44
        if step == 8'd3 { a = 8'd100; b = 8'd100; }   // s:200 -> +127 sat
        if step == 8'd4 { a = 8'd156; b = 8'd156; }   // s:(-100)+(-100)=-200 -> -128 sat
    }

    sync(clk.posedge) {
        if step == 8'd2 { assert u.sum == 8'd30, "u 10+20=30"; assert s.sum == 8'd30, "s 10+20=30"; }
        if step == 8'd3 { assert u.sum == 8'd255, "u sat 255"; assert s.sum == 8'd44, "s -56+100=44"; }
        if step == 8'd4 { assert s.sum == 8'h7F, "s pos sat +127"; }
        if step == 8'd5 { assert s.sum == 8'h80, "s neg sat -128"; }
    }

    seq {
        await clk.cycles(7);
        $display("SatAddTB: all checks passed");
        $finish;
    }
}
