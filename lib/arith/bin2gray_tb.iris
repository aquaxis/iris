/// Bin2Grayのテストベンチ
///
/// いくつかの2進値に対しGRAY符号（`bin ^ (bin >> 1)`）を確かめる。組み合わせ。
test Bin2GrayTB {
    let clk: clock(period: 10ns);
    var bin: bit[4] = 0;
    var step: bit[8] = 0;

    inst dut = Bin2Gray[Width: 4] { bin: bin };

    sync(clk.posedge) {
        step = step + 1;
        if step == 8'd2 { bin = 4'd4; }
        if step == 8'd4 { bin = 4'd8; }
        if step == 8'd6 { bin = 4'd15; }
    }

    sync(clk.posedge) {
        if step == 8'd3 { assert dut.gray == 4'd6, "gray(4)=6"; }
        if step == 8'd5 { assert dut.gray == 4'd12, "gray(8)=12"; }
        if step == 8'd7 { assert dut.gray == 4'd8, "gray(15)=8"; }
    }

    seq {
        await clk.cycles(9);
        $display("Bin2GrayTB: all checks passed");
        $finish;
    }
}
