/// Thermometerのテストベンチ
///
/// Width=8。value=0..8で、下位valueビットが1になる温度計コードを確かめる。
/// 組み合わせ回路なので入力varを変えて1サイクル待てば追従する。
test ThermometerTB {
    let clk: clock(period: 10ns);

    var value: bit[4] = 4'd0;

    inst d = Thermometer { value: value };

    seq {
        await clk.cycles(1);
        assert d.therm == 8'h00, "value 0 -> 0x00";

        value = 4'd1;
        await clk.cycles(1);
        assert d.therm == 8'h01, "value 1 -> 0x01";

        value = 4'd3;
        await clk.cycles(1);
        assert d.therm == 8'h07, "value 3 -> 0x07";

        value = 4'd5;
        await clk.cycles(1);
        assert d.therm == 8'h1F, "value 5 -> 0x1F";

        value = 4'd8;
        await clk.cycles(1);
        assert d.therm == 8'hFF, "value 8 -> 0xFF (all set)";

        $display("ThermometerTB: all checks passed");
        $finish;
    }
}
