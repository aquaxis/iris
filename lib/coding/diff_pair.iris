/// 差動（デュアルレール）符号化・復号（断線／故障検出つき）
///
/// 各データビット`d[i]`を2本の相補レール`{d[i], ~d[i]}`に符号化する（DiffEncode）。
/// 受信側（DiffDecode）はレール対が相補（0,1）または（1,0）なら正常としてビットを復元し、
/// 対が（0,0）や（1,1）になっていれば断線・スタックアット等の故障として`err`を立てる。
/// 安全系（機能安全）の信号線や、片側短絡・断線を検出したい経路に使う。
///
/// 符号化・復号ともに組み合わせ回路。ビットごとに独立なので`for`で1対ずつ組む
/// （部分ビット代入。`BitReverse`等と同じ）。`err`は「相補でない対」を集める必要があるが、
/// combは総和の畳み込みはできないので、対ごとの不良フラグをWidth幅ベクタ`bad`へ立てておき、
/// `err = bad != 0`（0との比較）で1本にまとめる（比較はcombで書ける）。
///
/// 符号のビット配置：`enc[2*i] = d[i]`（真値レール）、`enc[2*i+1] = ~d[i]`（相補レール）。
///
/// ジェネリックパラメータ:
/// - Width: データのビット幅（既定8、1以上）。符号は`2*Width`ビット。
mod DiffEncode[
    Width: uint = 8,
]
where
    Width >= 1,
(
    in  d:   bit[Width],
    out enc: bit[2 * Width],
) {
    comb {
        for i in 0..Width {
            enc[2 * i] = d[i];
            enc[2 * i + 1] = ~d[i];
        }
    }
}

/// 差動（デュアルレール）復号（`DiffEncode`の対）。
///
/// レール対が相補ならビットを復元し、相補でない対が1つでもあれば`err`を立てる。
///
/// ポート:
/// - enc: 符号（2*Widthビット）
/// - d:   復元したデータ（真値レール`enc[2*i]`）
/// - err: 相補でない対が1つでもあれば1（断線／故障）
mod DiffDecode[
    Width: uint = 8,
]
where
    Width >= 1,
(
    in  enc: bit[2 * Width],
    out d:   bit[Width],
    out err: bit,
) {
    var bad: bit[Width] = 0;
    comb {
        for i in 0..Width {
            d[i] = enc[2 * i];
            // 相補なら d^~d = 1。~(...)で「相補でない対」を1にする
            bad[i] = ~(enc[2 * i] ^ enc[2 * i + 1]);
        }
        err = bad != 0;
    }
}
