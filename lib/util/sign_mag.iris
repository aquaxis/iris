/// 符号絶対値（サインマグニチュード）⇔ 2の補数の変換
///
/// `Sm2Tc`は符号絶対値（最上位ビットが符号、下位Width-1ビットが絶対値）を2の補数に、
/// `Tc2Sm`はその逆を変換する。オーディオの一部フォーマット、符号絶対値ALU、浮動小数点の
/// 仮数処理などで、符号絶対値と2の補数を行き来するのに使う。組み合わせのみ。
///
/// combは同一ブロックで更新した信号を読み直せないが、これは選択・部分代入なので書ける。
/// `Sm2Tc`は符号ビットで分岐し、負なら絶対値（下位Width-1ビット）の2の補数`0 - mag`を、
/// 正なら絶対値をそのまま出す（絶対値はWidthへゼロ拡張される）。
/// `Tc2Sm`は負なら`0 - tc`で絶対値を作り、その下位Width-1ビットを置いて符号ビットを立てる
/// （部分代入で1式ずつ。`dout = dout | ...`のような再読みはしない）。正はそのまま（符号0）。
///
/// 注意：2の補数の最小値（`0x80..`＝-2^(Width-1)）は符号絶対値では表せない
/// （絶対値の最大は2^(Width-1)-1）。`Tc2Sm`に入れると絶対値が0に丸まる（-0扱い）。
///
/// ジェネリックパラメータ:
/// - Width: ビット幅（既定8、2以上）
mod Sm2Tc[
    Width: uint = 8,
]
where
    Width >= 2,
(
    in  sm: bit[Width],
    out tc: bit[Width],
) {
    comb {
        if sm[Width - 1] == 1 {
            // 負：絶対値をWidthへ拡張してから2の補数を取る（狭い幅で否定すると誤る）
            tc = 0 - sm[0 +: Width - 1].resize(Width);
        } else {
            // 正：絶対値をそのまま（Widthへゼロ拡張、.resizeで幅を明示）
            tc = sm[0 +: Width - 1].resize(Width);
        }
    }
}

/// 2の補数 → 符号絶対値（`Sm2Tc`の逆）。
///
/// ポート:
/// - tc: 2の補数の入力
/// - sm: 符号絶対値の出力（MSB＝符号、下位Width-1＝絶対値）
mod Tc2Sm[
    Width: uint = 8,
]
where
    Width >= 2,
(
    in  tc: bit[Width],
    out sm: bit[Width],
) {
    comb {
        if tc[Width - 1] == 1 {
            // 負：絶対値=0-tc、その下位Width-1ビットを置き符号ビットを立てる
            sm[0 +: Width - 1] = (0 - tc)[0 +: Width - 1];
            sm[Width - 1] = 1;
        } else {
            // 正：そのまま（符号0、絶対値=tc）
            sm = tc;
        }
    }
}
