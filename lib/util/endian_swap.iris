/// エンディアン変換（バイト順反転）
///
/// `din`のバイト順を反転して`dout`へ出す（バイトiは`din[(Bytes-1-i)*8 +: 8]`から取る）。
/// ビッグエンディアンとリトルエンディアンの相互変換、バス幅をまたぐデータの並べ替えなどに使う。
/// 組み合わせのみ。
///
/// バイト単位の部分選択（読み出し・書き込み）を`for`で1バイトずつ入れ替える。
///
/// ジェネリックパラメータ:
/// - Bytes: バイト数（既定4、1以上）
/// - Width: ビット幅（導出＝Bytes*8）
///
/// ポート:
/// - din:  入力（Bytesバイト）
/// - dout: バイト順を反転した出力
mod EndianSwap[
    Bytes: uint = 4,
    Width: uint = Bytes * 8,
]
where
    Bytes >= 1,
(
    in  din:  bit[Width],
    out dout: bit[Width],
) {
    comb {
        for i in 0..Bytes {
            dout[i * 8 +: 8] = din[(Bytes - 1 - i) * 8 +: 8];
        }
    }
}
