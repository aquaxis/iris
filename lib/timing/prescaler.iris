/// プリスケーラ（実行時可変の分周、ティック生成）
///
/// `en`のサイクルを`ratio`個ごとに1サイクル幅の`tick`で分周する。
/// `ClkDivider`が分周比をコンパイル時パラメータ`Div`で固定するのに対し、
/// こちらは分周比`ratio`を入力ポートで受け、実行時に変えられる（ボーレート生成、
/// タイマのプリスケーラ、可変レートのサンプリングなどに使う）。
/// クロックをゲーティングせず、クロックイネーブル（ティック）を出す方式。
///
/// カウンタは`en`のたびに1つ進み、`cnt + 1 >= ratio`で0へ戻ると同時に`tick`を出す。
/// `tick`は`en`が有効で終端に達したサイクルだけ1にする（`en`が0の間は保持し、`tick`も出さない）。
/// 終端判定を`==`でなく`>=`にしているのは、`ratio`を実行時に今の`cnt`より小さく変えても
/// 取り残されず次のサイクルで巻き戻すため（`==`だと全幅を一周するまでtickが出なくなる）。
/// 使う側は`ratio >= 1`を守ること（`ratio = 1`なら`en`のたびにtick）。
///
/// ジェネリックパラメータ:
/// - Width: 分周比とカウンタのビット幅（既定8、1以上）
///
/// ポート:
/// - en:    1のとき1つ進める（0なら保持）
/// - ratio: 分周比（この数の有効サイクルごとに1回tick）
/// - tick:  分周出力（1サイクル幅）
///
/// リセットは非同期assert・同期deassert、能動High。0で始まる。
mod Prescaler[
    Width: uint = 8,
]
where
    Width >= 1,
(
    in  clk:   clock,
    in  rst:   reset,
    in  en:    bit,
    in  ratio: bit[Width],
    out tick:  bit,
) {
    var cnt: bit[Width] = 0;

    sync(clk.posedge, rst.async) {
        if rst {
            cnt = 0;
        } else if en {
            if cnt + 1 >= ratio {
                cnt = 0;
            } else {
                cnt = cnt + 1;
            }
        }
    }

    comb {
        // 有効サイクルで終端に達したときだけ1サイクル幅のtickを出す。
        // `en & (cnt + 1 >= ratio)`のように`&`と`>=`を混ぜるとiris2svが片方を
        // 1ビットに切り詰める式を出すため、if文で書いて確実に変換させる。
        tick = 0;
        if en {
            if cnt + 1 >= ratio {
                tick = 1;
            }
        }
    }
}
