/// GrayCounterのテストベンチ
///
/// 許可中の出力がGRAY符号の並び（隣接値が1ビット差）になることを、
/// 既知のサイクルで確かめる。
test GrayCounterTB {
    let clk: clock(period: 10ns);
    let rst: reset;
    var en: bit = 1;
    var step: bit[8] = 0;

    inst dut = GrayCounter[Width: 4] { clk: clk, rst: rst, en: en };

    sync(clk.posedge) { step = step + 1; }

    sync(clk.posedge) {
        if step == 8'd6 { assert dut.gray == 4'd1, "gray(1)=1"; }
        if step == 8'd7 { assert dut.gray == 4'd3, "gray(2)=3"; }
        if step == 8'd8 { assert dut.gray == 4'd2, "gray(3)=2"; }
        if step == 8'd9 { assert dut.gray == 4'd6, "gray(4)=6"; }
    }

    seq {
        await clk.cycles(12);
        $display("GrayCounterTB: all checks passed");
        $finish;
    }
}
