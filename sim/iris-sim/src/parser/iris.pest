// IRIS Language Grammar (PEG)
// This file defines the grammar for the IRIS hardware description language

// Entry point - supports mod, test, and interface declarations
file = { SOI ~ (module_decl | test_mod_decl | interface_decl)* ~ EOI }

// Module definition (with ports)
module_decl = { "mod" ~ identifier ~ generics? ~ "(" ~ port_list ~ ")" ~ "{" ~ module_body ~ "}" }

// Test module definition (without ports, for testbenches)
test_mod_decl = { "test" ~ identifier ~ "{" ~ test_body ~ "}" }
test_body = { (signal_decl | logic_block | instance | seq_block | initial_block | fsm_block | mem_decl)* }

// Generics
generics = { "[" ~ generic_param ~ ("," ~ generic_param)* ~ "]" }
generic_param = { identifier ~ ":" ~ type_expr ~ ("=" ~ expr)? }

// Port list
port_list = { (port_decl ~ ("," ~ port_decl)*)? ~ ","? }
port_decl = { port_dir ~ identifier ~ ":" ~ type_expr }
port_dir = { "in" | "out" | "inout" | "initiator" | "target" | "monitor" }

// Module body
module_body = { (signal_decl | logic_block | instance | fsm_block | mem_decl)* }

// Signal declaration
signal_decl = { (let_decl | var_decl) ~ ";" }
let_decl = { "let" ~ "mut"? ~ identifier ~ (":" ~ type_expr)? ~ ("=" ~ expr)? }
var_decl = { "var" ~ identifier ~ (":" ~ type_expr)? ~ ("=" ~ expr)? }

// Logic blocks
logic_block = { comb_block | sync_block }
comb_block = { "comb" ~ "{" ~ statement* ~ "}" }
sync_block = { "sync" ~ "(" ~ clock_spec ~ ("," ~ reset_spec)? ~ ")" ~ "{" ~ statement* ~ "}" }

// Sequential block (for procedural testbench code)
seq_block = { "seq" ~ identifier? ~ "{" ~ seq_statement* ~ "}" }

// Initial block (executed once at simulation start)
initial_block = { "initial" ~ "{" ~ seq_statement* ~ "}" }

// FSM block (finite state machine)
fsm_block = { "fsm" ~ identifier ~ "(" ~ clock_spec ~ ("," ~ reset_spec)? ~ ")" ~ "{"
            ~ state_enum ~ transitions_block ~ output_block* ~ "}" }

// State enumeration
state_enum = { "state" ~ "enum" ~ "{" ~ state_item ~ ("," ~ state_item)* ~ ","? ~ "}" }
state_item = { identifier ~ moore_outputs? }
moore_outputs = { "[" ~ output_assign ~ ("," ~ output_assign)* ~ "]" }
output_assign = { identifier ~ "=" ~ expr }

// Transitions block
transitions_block = { "transitions" ~ "{" ~ transition_item* ~ "}" }
transition_item = { (identifier | "_") ~ "=>" ~ "{" ~ when_clause* ~ "}" }
when_clause = { "when" ~ expr ~ "{" ~ transition_action* ~ "}" }
transition_action = { goto_stmt | assign_stmt }
goto_stmt = { "goto" ~ identifier ~ ";" }

// Output block (for Mealy-style outputs)
output_block = { "output" ~ identifier ~ "{" ~ output_case* ~ "}" }
output_case = { identifier ~ "=>" ~ expr ~ "," }

// Interface definition
interface_decl = { "interface" ~ identifier ~ generics? ~ "{" ~ interface_body ~ "}" }
interface_body = { (interface_signal | view_def)* }
interface_signal = { "logic"? ~ identifier ~ ":" ~ type_expr ~ ";" }
view_def = { "view" ~ identifier ~ "{" ~ view_signal* ~ "}" }
view_signal = { view_direction ~ identifier ~ ";" }
view_direction = { "in" | "out" | "inout" }

// Memory declaration
mem_decl = { "mem" ~ identifier ~ ":" ~ mem_type ~ mem_config? ~ ("=" ~ mem_initializer)? ~ ";" }
mem_type = { base_type ~ "[" ~ integer ~ "]" }
mem_config = { "{" ~ config_item* ~ "}" }
config_item = { config_key ~ ":" ~ config_value ~ ","? }
config_key = { "ports" | "type" | "read_mode" | "write_mode" | "init_file" }
config_value = { string_literal | mem_type_value | read_mode_value | identifier | integer }
mem_type_value = { "ram" | "rom" }
read_mode_value = { "sync" | "async" }
mem_initializer = { array_initializer | string_literal }
array_initializer = { "{" ~ (expr ~ ("," ~ expr)*)? ~ "}" }

// Sequential statements
seq_statement = { await_stmt | delay_stmt | assert_stmt | signal_write | assign_stmt | if_stmt | seq_for_stmt | seq_while_stmt }

// Sequential for/while loops (for test blocks)
seq_for_stmt = { "for" ~ identifier ~ "in" ~ range_expr ~ "{" ~ seq_statement* ~ "}" }
seq_while_stmt = { "while" ~ expr ~ "{" ~ seq_statement* ~ "}" }

// Await statement
await_stmt = { "await" ~ await_expr ~ ";" }
await_expr = { clock_cycles | clock_edge_expr | until_expr }
clock_cycles = { identifier ~ "." ~ "cycles" ~ "(" ~ expr ~ ")" }
clock_edge_expr = { identifier ~ "." ~ clock_edge }
until_expr = { "until" ~ "(" ~ expr ~ ("," ~ "timeout" ~ ":" ~ duration)? ~ ")" }

// Delay statement (#10ns, #100)
delay_stmt = { "#" ~ duration ~ ";" }
duration = { integer ~ time_unit? }
time_unit = { "ns" | "us" | "ms" | "ps" | "s" }

// Signal access
signal_write = { signal_path ~ "." ~ "set" ~ "(" ~ expr ~ ")" ~ ";" }
signal_read = { signal_path ~ "." ~ "value" ~ "(" ~ ")" }
signal_path = { identifier ~ ("." ~ identifier)* }

// Assert statement
assert_stmt = { "assert" ~ expr ~ ("," ~ string_literal)? ~ ";" }
string_literal = { "\"" ~ string_content ~ "\"" }
string_content = { (!("\"") ~ ANY)* }

// Clock and reset specifications
clock_spec = { identifier ~ "." ~ clock_edge }
clock_edge = { "posedge" | "negedge" }
reset_spec = { identifier ~ "." ~ reset_mode }
reset_mode = { "sync" | "async" }

// Instance
instance = { "inst" ~ identifier ~ array_size? ~ "=" ~ identifier ~ generic_args? ~ "{" ~ port_connections ~ "}" ~ ";" }
array_size = { "[" ~ integer ~ "]" }
generic_args = { "[" ~ generic_arg ~ ("," ~ generic_arg)* ~ "]" }
generic_arg = { identifier ~ ":" ~ expr }
port_connections = { port_connection ~ ("," ~ port_connection)* ~ ","? }
port_connection = { identifier ~ ":" ~ expr }

// Types
type_expr = { base_type ~ array_suffix* }
base_type = { bit_type | clock_type | reset_type | identifier }
bit_type = { "bit" ~ ("[" ~ width_expr ~ "]")? }
clock_type = { "clock" ~ clock_config? }
clock_config = { "(" ~ "period" ~ ":" ~ duration ~ ")" }
reset_type = { "reset" ~ reset_config? }
reset_config = { "(" ~ reset_param ~ ("," ~ reset_param)* ~ ")" }
reset_param = { reset_active_low | reset_assert_cycles | reset_assert_time }
reset_active_low = { "active_low" ~ ":" ~ bool_literal }
reset_assert_cycles = { "assert_cycles" ~ ":" ~ integer }
reset_assert_time = { "assert_time" ~ ":" ~ duration }
bool_literal = { "true" | "false" }
width_expr = { expr ~ (":" ~ expr)? }
array_suffix = { "[" ~ integer ~ "]" }

// Statements
statement = { assign_stmt | if_stmt | match_stmt | for_stmt | while_stmt }
assign_stmt = { identifier ~ "=" ~ expr ~ ";" }
if_stmt = { "if" ~ expr ~ "{" ~ statement* ~ "}" ~ ("else" ~ "{" ~ statement* ~ "}")? }
match_stmt = { "match" ~ expr ~ "{" ~ match_arm* ~ "}" }
match_arm = { pattern ~ "=>" ~ (expr | "{" ~ statement* ~ "}") ~ ","? }
pattern = { "_" | literal | identifier }

// Loop statements
for_stmt = { "for" ~ identifier ~ "in" ~ range_expr ~ "{" ~ statement* ~ "}" }
range_expr = { expr ~ range_op ~ expr }
range_op = { "..=" | ".." }
while_stmt = { "while" ~ expr ~ "{" ~ statement* ~ "}" }

// Expressions
expr = { unary_expr ~ (bin_op ~ unary_expr)* }
unary_expr = { unary_op* ~ primary_expr ~ postfix* }
primary_expr = { literal | identifier | paren_expr | concat_expr | if_expr }
paren_expr = { "(" ~ expr ~ ")" }
concat_expr = { "{" ~ expr ~ ("," ~ expr)* ~ "}" }
if_expr = { "if" ~ expr ~ "{" ~ expr ~ "}" ~ "else" ~ "{" ~ expr ~ "}" }

// Postfix operators
postfix = { index | slice | method_call | field_access }
index = { "[" ~ expr ~ "]" }
slice = { "[" ~ expr ~ ":" ~ expr ~ "]" }
method_call = { "." ~ identifier ~ ("[" ~ expr ~ "]")? }
field_access = { "." ~ identifier }

// Operators
bin_op = {
    "&&" | "||" |
    "==" | "!=" | "<=" | ">=" | "<" | ">" |
    "<<" | ">>" |
    "+" | "-" | "*" | "/" | "%" |
    "&" | "|" | "^"
}
unary_op = { "!" | "~" | "-" }

// Literals
literal = { sized_literal | integer }
sized_literal = { integer ~ "'" ~ (bin_literal | hex_literal | dec_literal) }
bin_literal = { "b" ~ bin_digits }
hex_literal = { "h" ~ hex_digits }
dec_literal = { "d" ~ integer }
bin_digits = @{ ('0'..'1' | "_")+ }
hex_digits = @{ ('0'..'9' | 'a'..'f' | 'A'..'F' | "_")+ }

// Basic tokens
identifier = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
integer = @{ ASCII_DIGIT+ }

// Keywords - must be followed by non-identifier character
keyword = @{
    ("mod" | "test" | "let" | "mut" | "var" | "comb" | "sync" | "if" | "else" | "match" |
    "in" | "out" | "inout" | "initiator" | "target" | "monitor" | "bit" | "clock" | "reset" | "inst" |
    "posedge" | "negedge" | "async" | "active_low" | "period" | "assert_cycles" | "assert_time" | "true" | "false" |
    "seq" | "initial" | "await" | "until" | "assert" | "cycles" | "set" | "value" | "timeout" |
    "fsm" | "state" | "enum" | "transitions" | "when" | "goto" | "output" |
    "mem" | "ports" | "type" | "read_mode" | "write_mode" | "init_file" | "ram" | "rom" |
    "interface" | "logic" | "view" | "for" | "while") ~ !(ASCII_ALPHANUMERIC | "_")
}

// Whitespace and comments
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = { "//" ~ (!"\n" ~ ANY)* }
block_comment = { "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
